# MySQL Database Configuration
# ============================================
# IMPORTANT: Copy this file to .env and customize for your personal setup
# Each developer should have their own .env file with unique database name
# This prevents "Too many connections" errors in multi-developer environment
# ============================================

# MySQL Server Connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=

# Database Name - CHANGE THIS FOR EACH DEVELOPER!
# ⚠️ CRITICAL: Each developer MUST use unique database name to avoid conflicts
# Examples:
#   - plat_detection_andra
#   - plat_detection_bob
#   - plat_detection_alice
#   - plat_detection_YOUR_NAME
MYSQL_DATABASE=plat_detection_YOUR_NAME_HERE

# Connection Pool Settings (OPTIMIZED for multi-developer environment)
# Reduced from 5 to 3 to prevent connection exhaustion (40% reduction)
MYSQL_POOL_SIZE=3
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30

# Connection Timeout Settings (NEW - Auto-cleanup stale connections)
# Idle connections will be closed after 5 minutes (300 seconds)
# Health check runs every 60 seconds to remove broken connections
MYSQL_MAX_IDLE_TIME=300
MYSQL_HEALTH_CHECK_INTERVAL=60

# Feature Flags
USE_MYSQL_DATABASE=True
ENABLE_ACCESS_CONTROL=True
LOG_DENIED_ACCESS=True
AUTO_UPDATE_VEHICLE_STATUS=True

# Dual Mode Settings (SQLite + MySQL)
ENABLE_SQLITE_LOGGING=True
ENABLE_MYSQL_ACCESS_CONTROL=True

# Image Preprocessing Settings
ENABLE_DESKEWING=True
ENABLE_PERSPECTIVE_CORRECTION=True
ENABLE_ENHANCEMENT=True
ENABLE_MULTI_ANGLE_OCR=False

# ============================================
# QUICK SETUP INSTRUCTIONS:
# ============================================
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Edit .env and change MYSQL_DATABASE to your name:
#    MYSQL_DATABASE=plat_detection_andra  # Change 'andra' to your name
#
# 3. Create your personal database in phpMyAdmin:
#    a. Open http://localhost/phpmyadmin
#    b. Click "New" button (left sidebar)
#    c. Database name: plat_detection_YOUR_NAME
#    d. Collation: utf8mb4_unicode_ci
#    e. Click "Create"
#
# 4. Run database setup script:
#    python scripts/setup_database.py
#
# 5. Start your application:
#    python headless_stream.py
#
# For detailed documentation, see MYSQL_SETUP.md
# ============================================
